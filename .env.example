# YourBot status_service — example .env
# Copy to /etc/status/.env on the Ubuntu host (chmod 600).

# Probe configuration
PROBE_BASE_URL=https://yourbot.gg
PROBE_INTERVAL_SECONDS=60

# A failed website check is retried this many times in total before it is
# believed (delays grow from PROBE_RETRY_DELAY_SECONDS).
PROBE_ATTEMPTS=3
PROBE_RETRY_DELAY_SECONDS=2

# After a failed website check, the monitor tests its OWN connection against
# these (comma-separated, unrelated networks). If none answer, the cycle is
# stored as "no data" instead of as downtime. Blank disables the self-check.
MONITOR_CONTROL_URLS=https://www.gstatic.com/generate_204,https://cloudflare.com/cdn-cgi/trace

# Discord's public status summary, shown under "Outside YourBot". Blank hides it.
DISCORD_STATUS_URL=https://discordstatus.com/api/v2/summary.json

# Seconds the computed page is reused between requests (checks land once a minute).
API_CACHE_SECONDS=10

# Only for a second instance (preview/staging): a different User-Agent, so its
# requests can be told apart from the real prober's in the platform's logs.
# Must keep the "yourbot-status/" prefix. Leave unset in production.
# PROBE_USER_AGENT=yourbot-status/1.1-preview

# Storage
DB_PATH=/data/status.db

# Web server
HOST=0.0.0.0
PORT=8081

# Optional: an authenticated check of Discord's API (skipped if blank). Use a
# token with `identify` scope only. Not needed for the Discord status row above.
DISCORD_BOT_TOKEN=

# Discord webhook alerts (skipped if blank)
ALERT_DISCORD_WEBHOOK_URL=
ALERT_THRESHOLD_MIN=3
ALERT_COOLDOWN_MIN=15
# board = ONE live status message edited in place (default, no spam)
# stream = legacy one-message-per-event alerts
ALERT_STYLE=board

# Board mode: optional mention (e.g. <@&ROLE_ID> or @everyone) posted as a
# separate ping ONLY when overall status becomes a major outage; the ping
# message is deleted again on recovery. Blank = never ping.
ALERT_OUTAGE_MENTION=

# Cap on visitor-registered webhook subscribers (abuse guard)
MAX_WEBHOOK_SUBSCRIBERS=500

# External heartbeat (skipped if blank). e.g. https://hc-ping.com/<uuid>
HEARTBEAT_PING_URL=

# Manual announcements admin auth — generate with: openssl rand -hex 32
ADMIN_HMAC_SECRET=

# One-time bootstrap token for the first /admin owner account.
# Visit /admin/setup?token=<this> while no owner exists; ignored afterward.
ADMIN_BOOTSTRAP_TOKEN=

# SLA target for the header line
SLA_TARGET_PCT=99.9

# SSL probe early-warning thresholds (days)
RR_SSL_WARN_DAYS=14
RR_SSL_CRITICAL_DAYS=3

# Backups — Litestream hot replication to Cloudflare R2 (S3-compatible)
BACKUP_ENABLED=1
LITESTREAM_REPLICA_URL=s3://mmo-maid-status-backups/status.db?endpoint=https://<account-id>.r2.cloudflarestorage.com&region=auto&force-path-style=true
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Cold snapshots via scripts/backup.sh
RCLONE_REMOTE=r2
BACKUP_BUCKET=mmo-maid-status-backups

# Brand
BRAND_DISCORD_INVITE=https://discord.gg/yourbot
BRAND_BOT_AVATAR_URL=
BRAND_GITHUB_URL=
BRAND_LOGO_URL=/static/yourbot-logo.png
MAIN_SITE_URL=https://yourbot.gg

# Public URL of this status page (alert embeds + feed links) and badge label
STATUS_PUBLIC_URL=https://status.yourbot.work
BADGE_LABEL=yourbot
